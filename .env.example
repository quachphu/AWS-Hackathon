# Copy to .env.local and fill what your lane owns. NEVER commit .env.local.
# Everything degrades to mocks when its keys are missing — the app runs with zero keys.
# This file is APPEND-ONLY (see CONTRIBUTION.md): add lines, don't reorder.

# A — gateway / models
TRUEFOUNDRY_GATEWAY_URL=    # OpenAI-compatible base URL
TRUEFOUNDRY_API_KEY=
BASE_MODEL=                 # base model id behind the gateway (cost comparison)
PIONEER_MODEL=              # tuned model id registered behind the gateway

# C - local OpenAI agent for OpenUI remix chat
OPENAI_API_KEY=
OPEN_AI_API=                # optional alias; app accepts either name
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=            # optional; defaults to https://api.openai.com/v1

# B — render + metrics
CLICKHOUSE_URL=
CLICKHOUSE_PASSWORD=
REPLICATE_API_TOKEN=        # image
FAL_KEY=                    # video
# BLOB_READ_WRITE_TOKEN=    # (retired — we host on Render, not Vercel; mirror via Cloudinary below)
CLOUDINARY_URL=             # mirror rendered artifacts to Cloudinary CDN; cloudinary://<api_key>:<api_secret>@<cloud_name>
APIFY_TOKEN=                # scrape a TikTok URL → transcript (falls back to the gateway LLM, then a mock)
# APIFY_TIKTOK_ACTOR=      # optional override; default clockworks~tiktok-scraper

# D — publish (Composio → TikTok + Instagram)
# Get from: https://app.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=
COMPOSIO_API=              # optional alias; app accepts either name
# Composio user_id — hardcoded to "ad-factory-demo-user" in lib/composio/publish.ts
# Connect TikTok + Instagram at: https://app.composio.dev → Toolkits → connect account

# A — Pioneer training ops (scripts/pioneer-train.mjs + the self-hosted model auth)
PIONEER_API_KEY=
